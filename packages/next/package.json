{
  "name": "@intelroute/next",
  "version": "0.1.0",
  "description": "Next.js integration for IntelRoute: middleware/proxy, route discovery and not-found suggestions.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./discover": {
      "types": "./dist/discover.d.ts",
      "import": "./dist/discover.js"
    }
  },
  "bin": {
    "intelroute": "./dist/cli.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p ."
  },
  "dependencies": {
    "@intelroute/core": "0.1.0"
  },
  "peerDependencies": {
    "next": ">=14"
  },
  "devDependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "license": "MIT"
}
