{
  "name": "intelroute-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build -w @intelroute/core && npm run build -w @intelroute/next",
    "test": "vitest run",
    "typecheck": "tsc -p packages/core --noEmit && tsc -p packages/next --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
